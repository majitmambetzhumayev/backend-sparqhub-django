SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_HOST=localhost        # use 'db' inside Docker
DATABASE_NAME=mydb
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_PORT=5432

REDIS_URL=redis://localhost:6379/0    # use 'redis://redis:6379/0' inside Docker

CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Used to build links that must point at the frontend (password reset,
# email confirmation, OAuth redirect) rather than this backend.
FRONTEND_URL=http://localhost:3000
# Blank means host-only cookies (correct for local dev). In prod, if the
# frontend/backend are on sibling subdomains of the same domain, set this to
# the shared parent, e.g. .example.com — otherwise auth cookies never reach
# the frontend's own domain even though it's "same-site".
COOKIE_DOMAIN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
FIELD_ENCRYPTION_KEY=
SENTRY_DSN=

# Agent/LLM-call tracing (OpenTelemetry GenAI conventions, see
# ai_providers/observability.py). Blank endpoint = spans still generated,
# printed to the console only (no collector configured). OTEL_EXPORTER_OTLP_HEADERS
# is read directly from the environment by the OTel SDK itself (standard
# OTel env var, not passed through settings.py). Format: comma-separated
# key=value pairs, URL-encoded values.
#
# Currently pointed at Sentry's own OTLP ingest (same project as SENTRY_DSN
# below) -- confirmed working 2026-09-10. Two things that aren't obvious
# from Sentry's dashboard when setting this up:
#   1. The endpoint needs a manually-appended /v1/traces -- the URL Sentry
#      shows you (".../integration/otlp") 404s without it.
#   2. Auth header format: x-sentry-auth=sentry%20sentry_key=<DSN's public
#      key, the part before '@'>.
# If pointing this at Grafana Cloud's Tempo instead, use
# Authorization=Basic%20<base64(instance_id:api_key)> instead of x-sentry-auth.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Generated-image storage (Cloudflare R2) — blank means local disk instead
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@sparqup.fr

# OAuth2 social login — blank means the corresponding provider's
# login/callback endpoints will fail (authlib needs real credentials to
# register with Google/GitHub).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
